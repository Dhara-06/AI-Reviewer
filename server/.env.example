# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/ai_review_system

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_ai_review_system_2026_dev_seed
JWT_EXPIRES_IN=7d

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# GitHub REST API
GITHUB_TOKEN=

# SMTP / Nodemailer
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AI Intern Review Automation" <noreply@aireviewsystem.com>
MOCK_EMAIL=true

# Google Calendar & Meet
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/meetings/oauth2callback
GOOGLE_REFRESH_TOKEN=
MOCK_CALENDAR=true

# Defaults
DEFAULT_EXPLANATION_INTERVAL_DAYS=2
DEFAULT_REVIEW_INTERVAL_DAYS=2
REMINDER_HOURS_BEFORE_MEETING=4
TIMEZONE=Asia/Kolkata
