# Server Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/ai_review_system

# JWT Authentication
JWT_SECRET=change_this_to_a_secure_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Set MOCK_GEMINI=true to test without Gemini API key; false to use live Gemini API
MOCK_GEMINI=true

# GitHub REST API
# Personal Access Token (classic or fine-grained) with 'repo' scope for private repos
GITHUB_TOKEN=
MOCK_GITHUB=false

# Email (SMTP / Nodemailer)
# Use real credentials (Gmail, Sendgrid, Ethereal, AWS SES) or keep MOCK_EMAIL=true
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=AI Intern Review Automation <noreply@aireviewsystem.com>
# When MOCK_EMAIL=true, emails are rendered, validated, logged to MongoDB, but not sent via network
MOCK_EMAIL=true

# Google Calendar API (OAuth 2.0 with Google Meet conference creation)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/meetings/oauth2callback
GOOGLE_REFRESH_TOKEN=
# When MOCK_CALENDAR=true, genuine-format Google Meet links and calendar events are generated for testing
MOCK_CALENDAR=true

# Lifecycle & Scheduling Defaults (in days)
DEFAULT_EXPLANATION_INTERVAL_DAYS=2
DEFAULT_REVIEW_INTERVAL_DAYS=2
REMINDER_HOURS_BEFORE_MEETING=4
TIMEZONE=Asia/Kolkata
